# ======================================================================
# MCPFP - Configuracion del OBJETIVO UNICO
# ----------------------------------------------------------------------
# El MCP solo puede apuntar a UNA maquina virtual a la vez.
# Copia este archivo a .env y completa los valores del laboratorio.
#
# USO EXCLUSIVO EN LABORATORIOS AUTORIZADOS (VulnHub, HTB, rangos propios).
# ======================================================================

# IP o hostname de la maquina virtual objetivo (obligatorio)
MCPFP_TARGET_HOST=192.168.56.101

# Nombre descriptivo del laboratorio (opcional)
MCPFP_TARGET_NAME=VulnHub-Ejemplo

# Confirmacion explicita de que tienes autorizacion sobre el objetivo.
# Debe valer exactamente "true" o el MCP se negara a operar.
MCPFP_AUTHORIZED=false

# Rango de puertos a considerar en el reconocimiento (opcional)
# Ejemplos: "1-1000", "22,80,443,8080", "-" (todos)
MCPFP_PORT_RANGE=1-1000

# Credenciales de laboratorio si el ejercicio las provee (opcional, NO obligatorio)
MCPFP_LAB_USER=
MCPFP_LAB_PASSWORD=

# Carpeta donde se escriben los reportes (opcional; por defecto ./reports)
MCPFP_REPORT_DIR=reports
